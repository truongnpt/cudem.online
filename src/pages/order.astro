---
export const prerender = false;

import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import Container from "../components/shared/Container.astro";
import Title from "../components/shared/Title.astro";
import Paragraph from "../components/shared/Paragraph.astro";
import BtnLink from "../components/shared/BtnLink.astro";
import { packageServices } from "../utils/data.ts";

const idParam = Astro.url.searchParams.get("id");
const pkg =
    typeof idParam === "string"
        ? packageServices.find((p) => p.id === idParam)
        : undefined;

const formatVnd = (amount: number) =>
    `${amount.toLocaleString("vi-VN")} VNĐ`;

const layoutTitle = pkg ? `Đặt gói: ${pkg.title}` : "Đặt dịch vụ";

const discounted =
    pkg &&
    typeof pkg.priceVnd === "number" &&
    pkg.discountPercent > 0
        ? Math.round(pkg.priceVnd * (1 - pkg.discountPercent / 100))
        : null;
---

<Layout title={layoutTitle}>
    <main class="min-h-[50vh] py-16 md:py-24">
        <Container className="max-w-3xl">
            <div
                class="rounded-3xl border border-box-border bg-box-bg p-8 sm:p-10 shadow-lg shadow-box-shadow relative overflow-hidden space-y-6"
            >
                {
                    pkg ? (
                        <>
                            <div class="relative space-y-3">
                                <p class="text-sm font-semibold uppercase tracking-wide text-primary">
                                    Xác nhận gói
                                </p>
                                <Title>{pkg.title}</Title>
                                {typeof pkg.priceVnd === "number" &&
                                pkg.discountPercent > 0 &&
                                discounted != null ? (
                                    <Paragraph>
                                        Giá niêm yết{" "}
                                        <span class="line-through opacity-75">
                                            {formatVnd(pkg.priceVnd)}
                                        </span>
                                        {" — "}
                                        <span class="font-semibold text-heading-2">
                                            Ưu đãi ({pkg.discountPercent}%):{" "}
                                            <span class="text-primary">
                                                {formatVnd(discounted)}
                                            </span>
                                        </span>
                                    </Paragraph>
                                ) : typeof pkg.priceVnd === "number" ? (
                                    <Paragraph>
                                        Giá trọn gói:{" "}
                                        <span class="font-semibold text-heading-2">
                                            {formatVnd(pkg.priceVnd)}
                                        </span>
                                    </Paragraph>
                                ) : (
                                    <Paragraph>
                                        Liên hệ để báo giá phù hợp — gói này không áp đặt mức cố định trên hệ thống.
                                    </Paragraph>
                                )}
                            </div>
                            <ul class="relative space-y-2 text-heading-3 md:text-lg">
                                {
                                    pkg.features.map((feature) => (
                                        <li class="flex gap-3">
                                            <span
                                                class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-primary"
                                                aria-hidden="true"
                                            />
                                            <span>{feature}</span>
                                        </li>
                                    ))
                                }
                            </ul>
                            <Paragraph>
                                Tiếp theo chúng tôi có thể thu thập brief, lên timeline và tiến hành khảo sát chi tiết. Bạn cũng có thể nhắn trực tiếp qua form liên hệ.
                            </Paragraph>
                            <div class="flex flex-wrap gap-4 relative pt-2">
                                <BtnLink
                                    variant="secondary"
                                    href={`/contact?package=${pkg.id}`}
                                    text="Liên hệ tư vấn"
                                />
                                <BtnLink
                                    variant="primary"
                                    href="/"
                                    text="Quay về trang chủ"
                                />
                            </div>
                            <span class="pointer-events-none absolute -bottom-20 -right-20 w-40 aspect-square rounded-full bg-primary/10" />
                        </>
                    ) : (
                        <div class="relative space-y-6 text-center py-6">
                            <Title>Không tìm thấy gói</Title>
                            <Paragraph>
                                Liên kết đặt dịch vụ không hợp lệ hoặc gói đã ngừng cung cấp. Vui lòng quay về danh sách gói trên trang chủ.
                            </Paragraph>
                            <BtnLink
                                variant="primary"
                                href="/#package-services"
                                text="Xem các gói dịch vụ"
                                className="inline-flex"
                            />
                            <span class="pointer-events-none absolute -bottom-16 -left-16 w-32 aspect-square rounded-full bg-primary/10" />
                        </div>
                    )
                }
            </div>
        </Container>
    </main>
</Layout>
