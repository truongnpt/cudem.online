---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import Hero from "../components/sections/Hero.astro";
import Services from "../components/sections/Services.astro";
import AboutUs from "../components/sections/AboutUs.astro";
import Features from "../components/sections/Features.astro";
import CTA from "../components/sections/CTA.astro";
import ComtactForm from "../components/sections/ComtactForm.astro";
import Brands from "../components/sections/Brands.astro";
import PackageServices from "../components/sections/PackageServices.astro";
import { app } from "../configs/app";
---

<Layout title={app.webcomeMessage}>
  <main class="flex flex-col gap-y-20 md:gap-y-32 overflow-hidden">
    <Hero />
    <Brands />
    <PackageServices />
    <Services />
    <AboutUs />
    <Features />
    <CTA />
    <ComtactForm />
  </main>
</Layout>
