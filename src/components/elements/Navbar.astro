---
import BtnLink from "../shared/BtnLink.astro";
import Container from "../shared/Container.astro";
import Navitem from "../shared/Navitem.astro";
import { app } from "../../configs/app";
import { services, projects } from "../../utils/data";
const navItems = [
  {
    href: "/",
    text: "Trang chủ",
  },
  {
    href: "/services",
    text: "Dịch vụ",
    children: services.map((s) => ({
      href: `/services/${s.slug}`,
      text: s.title,
    })),
  },
  {
    href: "/packages",
    text: "Giá dịch vụ",
  },
  {
    href: "/projects",
    text: "Dự án",
    children: [
      { href: "/projects/website", text: projects[0].title },
      { href: "/projects/web-application", text: projects[1].title },
    ],
  },
  {
    href: "/about-us",
    text: "Về chúng tôi",
  },
  {
    href: "https://the-gioi-kho.vercel.app",
    text: "Cửa hàng",
    target: "_blank",
  },
];
---

<header
  data-site-header
  class="nav-header absolute inset-x-0 top-0 z-50 w-full"
>
  <Container className="nav-header-inner py-6 sm:py-6">
    <div
      data-nav-shell
      class="overflow-visible rounded-full border border-transparent px-3 sm:px-5 lg:px-6 py-2 sm:py-2.5 transition-[background-color,border-color,box-shadow,backdrop-filter] duration-300 ease-out"
    >
      <div class="bg-cu-dem-gradient transition-all duration-300 ease-out w-20 h-20 dark:bg-gradient-to-r from-primary to-green-500 rounded-full absolute left-[12%] top-[15%] blur-2xl"></div>
      <nav class="w-full flex justify-between items-center gap-6 relative">
        <!-- logo -->
        <div class="min-w-max inline-flex relative z-50">
          <a href="/" class="relative flex items-center gap-3">
            <img src={app.logo} alt={app.name} width="40" height="40" />
            <!-- <h1 class="inline-flex text-lg font-semibold text-heading-1">
              {app.name}
            </h1> -->
          </a>
        </div>

        <!-- desktop-only; overlay/drawer stay outside shell (backdrop-filter breaks fixed descendants) -->
        <div
          class="hidden lg:flex lg:flex-1 lg:min-w-0 lg:flex-row lg:justify-between lg:items-center lg:gap-x-4"
        >
          <ul
            data-desktop-nav
            class="relative z-[999] flex flex-wrap lg:flex-nowrap items-center gap-x-1 gap-y-2 text-lg text-heading-2 w-full lg:flex-1 lg:justify-center"
          >
            <span
              data-desktop-nav-indicator
              aria-hidden="true"
              class="desktop-nav-indicator"></span>
            {
              navItems.map((item, i) => {
                return (
                  <Navitem
                    {...item}
                    submenuInstanceId={`d-${i}`}
                    target={item.target}
                  />
                );
              })
            }
          </ul>
          <div class="lg:min-w-max flex items-center sm:w-max">
            <BtnLink
              text="Liên hệ"
              href="/contact"
              className="flex justify-center w-full sm:w-max"
              variant="primary"
            />
          </div>
        </div>

        <div class="min-w-max flex items-center gap-x-3 relative z-50">
          <button
            data-switch-theme
            class="cursor-pointer outline-none flex relative text-heading-2 rounded-full p-2 lg:p-3 border border-box-border bg-transparent transition-[border-color,background-color,backdrop-filter] duration-300"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="w-6 h-6 dark:flex hidden"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z"
              ></path>
            </svg>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="w-6 h-6 dark:hidden"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z"
              ></path>
            </svg>

            <span class="sr-only">switch theme</span>
          </button>

          <button
            type="button"
            data-toggle-nav
            data-open-nav="false"
            aria-expanded="false"
            aria-controls="mobile-nav-drawer"
            class="lg:hidden lg:invisible outline-none w-7 h-auto flex flex-col relative"
          >
            <span
              id="line1"
              class="w-6 h-0.5 rounded-full bg-heading-2 transition-all duration-300 ease-linear"
            ></span>
            <span
              id="line2"
              class="w-6 origin-center mt-1 h-0.5 rounded-full bg-heading-2 transition-all duration-300 ease-linear"
            ></span>
            <span
              id="line3"
              class="w-6 mt-1 h-0.5 rounded-full bg-heading-2 transition-all duration-300 ease-linear"
            ></span>
            <span class="sr-only">togglenav</span>
          </button>
        </div>
      </nav>
    </div>

    <!-- Siblings of [data-nav-shell] so fixed layers use the viewport -->
    <div
      data-nav-overlay
      aria-hidden="true"
      class="mobile-nav-overlay fixed inset-0 z-[9998] hidden lg:!hidden bg-box-bg/55 backdrop-blur-xl"
    >
    </div>
    <div
      id="mobile-nav-drawer"
      data-navbar
      data-drawer-open="false"
      class="mobile-nav-drawer flex flex-col gap-y-8 gap-x-4 z-[9999] w-full max-lg:fixed max-lg:inset-0 max-lg:min-h-dvh max-lg:w-full max-lg:bg-body max-lg:px-6 max-lg:pt-[max(1.75rem,env(safe-area-inset-top))] max-lg:pb-10 max-lg:overflow-y-auto lg:hidden"
    >
      <div
        class="flex shrink-0 items-center justify-between gap-4 border-b border-box-border/40 pb-4 mb-2"
      >
        <a href="/" class="flex min-w-0 items-center gap-3">
          <img
            src={app.logo}
            alt=""
            width="40"
            height="40"
            class="size-10 shrink-0"
          />
          <!-- <span class="truncate text-lg font-semibold text-heading-1">
            {app.name}
          </span> -->
        </a>
        <button
          type="button"
          data-close-drawer
          class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-box-border bg-box-bg text-heading-2"
          aria-label="Đóng menu"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.75"
            stroke="currentColor"
            class="h-5 w-5"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6 18 18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <ul
        class="flex flex-col gap-x-3 text-lg text-heading-2 w-full px-0 pt-0 border-0"
      >
        {
          navItems.map((item, i) => {
            return (
              <Navitem
                {...item}
                submenuInstanceId={`m-${i}`}
                target={item.target}
              />
            );
          })
        }
      </ul>

      <div
        class="flex items-center sm:w-max w-full pt-2 border-t border-box-border/40"
      >
        <BtnLink
          text="Liên hệ"
          href="/contact"
          className="flex justify-center w-full sm:w-max"
          variant="primary"
        />
      </div>
    </div>
  </Container>
</header>

<script is:inline>
  (function () {
    const header = document.querySelector("[data-site-header]");
    if (!header) return;
    const PINNED = "nav-header--pinned";
    const THRESHOLD = 40;
    function sync() {
      if (window.scrollY > THRESHOLD) header.classList.add(PINNED);
      else header.classList.remove(PINNED);
    }
    sync();
    window.addEventListener("scroll", sync, { passive: true });
  })();

  document.addEventListener("DOMContentLoaded", function () {
    document
      .querySelectorAll("[data-nav-submenu-toggle]")
      .forEach(function (btn) {
        btn.addEventListener("click", function (e) {
          e.stopPropagation();
          const id = btn.getAttribute("aria-controls");
          if (!id) return;
          const panel = document.getElementById(id);
          const expanded = btn.getAttribute("aria-expanded") === "true";
          const nextOpen = !expanded;
          btn.setAttribute("aria-expanded", nextOpen ? "true" : "false");
          if (panel) {
            if (nextOpen) {
              panel.setAttribute("data-open", "true");
              panel.setAttribute("aria-hidden", "false");
            } else {
              panel.removeAttribute("data-open");
              panel.setAttribute("aria-hidden", "true");
            }
          }
        });
      });

    const desktopNav = document.querySelector("[data-desktop-nav]");
    const indicator = desktopNav?.querySelector("[data-desktop-nav-indicator]");

    if (desktopNav && indicator) {
      const triggers = Array.from(
        desktopNav.querySelectorAll("[data-desktop-nav-trigger]"),
      );
      const parentByChildHref = new Map();

      if (triggers.length > 0) {
        desktopNav
          .querySelectorAll(".nav-submenu-parent")
          .forEach((parentItem) => {
            const parentTrigger = parentItem.querySelector(
              "[data-desktop-nav-trigger]",
            );
            if (!parentTrigger) return;
            parentItem
              .querySelectorAll(".nav-submenu-panel a[href]")
              .forEach((subLink) => {
                const href = subLink.getAttribute("href");
                if (href) parentByChildHref.set(href, parentTrigger);
              });
          });

        const setIndicator = (target) => {
          const navRect = desktopNav.getBoundingClientRect();
          const targetRect = target.getBoundingClientRect();
          const left = targetRect.left - navRect.left + desktopNav.scrollLeft;
          const top = targetRect.top - navRect.top + desktopNav.scrollTop;
          indicator.style.width = `${target.offsetWidth}px`;
          indicator.style.height = `${target.offsetHeight}px`;
          indicator.style.transform = `translate(${left}px, ${top}px)`;
          indicator.style.opacity = "1";
        };

        const normalizePath = (path) =>
          (path || "/").replace(/\/+$/, "") || "/";

        const resolveCurrentByView = () => {
          const currentHash = window.location.hash;
          if (currentHash && parentByChildHref.has(currentHash)) {
            return parentByChildHref.get(currentHash);
          }

          const byHash = triggers.filter((link) => {
            const href = link.getAttribute("href") || "";
            return href.startsWith("#") && href.length > 1;
          });
          const offsetY = 120;
          let activeHash = null;

          byHash.forEach((link) => {
            const href = link.getAttribute("href") || "";
            const section = document.querySelector(href);
            if (!section) return;
            const rect = section.getBoundingClientRect();
            if (rect.top <= offsetY && rect.bottom > offsetY) {
              activeHash = link;
            }
          });

          if (activeHash) return activeHash;

          const currentPath = normalizePath(window.location.pathname);
          const parentByPath = Array.from(parentByChildHref.entries()).find(
            ([href]) =>
              href.startsWith("/") && normalizePath(href) === currentPath,
          );
          if (parentByPath) return parentByPath[1];

          return (
            triggers.find((link) => {
              const href = link.getAttribute("href") || "";
              return (
                href.startsWith("/") && normalizePath(href) === currentPath
              );
            }) ||
            triggers.find(
              (link) => link.getAttribute("href") === currentHash,
            ) ||
            triggers[0]
          );
        };

        const markActive = (target) => {
          triggers.forEach((link) => {
            const isActive = link === target;
            if (isActive) {
              link.setAttribute("aria-current", "page");
              link.classList.add("desktop-nav-link-active");
            } else {
              link.removeAttribute("aria-current");
              link.classList.remove("desktop-nav-link-active");
            }
          });
        };

        let current = resolveCurrentByView();
        if (current) {
          markActive(current);
          setIndicator(current);
        }

        desktopNav.addEventListener("mouseover", (event) => {
          const trigger = event.target.closest("[data-desktop-nav-trigger]");
          if (!trigger || !desktopNav.contains(trigger)) return;
          setIndicator(trigger);
        });

        desktopNav.addEventListener("focusin", (event) => {
          const trigger = event.target.closest("[data-desktop-nav-trigger]");
          if (!trigger || !desktopNav.contains(trigger)) return;
          setIndicator(trigger);
        });

        desktopNav.addEventListener("click", (event) => {
          const trigger = event.target.closest("[data-desktop-nav-trigger]");
          if (!trigger || !desktopNav.contains(trigger)) return;
          current = trigger;
          markActive(trigger);
          setIndicator(trigger);
        });

        desktopNav.addEventListener("mouseleave", () => {
          if (current) setIndicator(current);
        });

        window.addEventListener(
          "scroll",
          () => {
            current = resolveCurrentByView();
            if (current) {
              markActive(current);
              setIndicator(current);
            }
          },
          { passive: true },
        );

        window.addEventListener("hashchange", () => {
          current = resolveCurrentByView();
          if (current) {
            markActive(current);
            setIndicator(current);
          }
        });

        window.addEventListener("resize", () => {
          current = resolveCurrentByView();
          if (current) {
            markActive(current);
            setIndicator(current);
          }
        });
      }
    }
  });
</script>

<style is:global>
  .nav-header.nav-header--pinned {
    position: fixed;
    top: 0.75rem;
    left: 0;
    right: 0;
  }

  .nav-header.nav-header--pinned .bg-cu-dem-gradient {
    display: none;
  }

  .nav-header-inner {
    transition:
      padding-top 0.3s ease,
      padding-bottom 0.3s ease;
  }

  .nav-header--pinned .nav-header-inner {
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
  }

  .nav-header--pinned [data-nav-shell] {
    border-color: rgb(255 255 255 / 0.25);
    background-color: rgb(255 255 255 / 0.18);
    box-shadow:
      0 8px 32px rgb(0 0 0 / 0.08),
      inset 0 1px 0 rgb(255 255 255 / 0.35);
    backdrop-filter: blur(24px) saturate(1.5);
    -webkit-backdrop-filter: blur(24px) saturate(1.5);
  }

  .dark .nav-header--pinned [data-nav-shell] {
    border-color: rgb(255 255 255 / 0.15);
    background-color: rgb(255 255 255 / 0.08);
    box-shadow:
      0 12px 40px rgb(0 0 0 / 0.45),
      inset 0 1px 0 rgb(255 255 255 / 0.1);
  }

  .nav-header--pinned [data-switch-theme] {
    border-color: rgb(255 255 255 / 0.3);
    background-color: rgb(255 255 255 / 0.2);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .dark .nav-header--pinned [data-switch-theme] {
    border-color: rgb(255 255 255 / 0.15);
    background-color: rgb(255 255 255 / 0.1);
  }

  @media (max-width: 1023px) {
    .mobile-nav-drawer {
      transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
      transform: translateX(100%);
      pointer-events: none;
    }

    .mobile-nav-drawer[data-drawer-open="true"] {
      transform: translateX(0);
      pointer-events: auto;
    }
  }

  @media (min-width: 1024px) {
    .mobile-nav-drawer {
      transform: none;
    }
  }

  .desktop-nav-indicator {
    position: absolute;
    left: 0;
    top: 0;
    border-radius: 9999px;
    background: rgb(39 152 36 / 0.12);
    border: 1px solid rgb(39 152 36 / 0.18);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.45);
    opacity: 0;
    transition:
      transform 0.24s cubic-bezier(0.2, 0.8, 0.2, 1),
      width 0.24s cubic-bezier(0.2, 0.8, 0.2, 1),
      height 0.24s cubic-bezier(0.2, 0.8, 0.2, 1),
      opacity 0.16s ease;
    pointer-events: none;
    z-index: 0;
  }

  .dark .desktop-nav-indicator {
    background: rgb(39 152 36 / 0.22);
    border-color: rgb(74 222 128 / 0.35);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.1);
  }

  .desktop-nav-link-active {
    color: rgb(39 152 36);
  }

  [data-nav-submenu-toggle][aria-expanded="true"] .nav-submenu-chevron {
    transform: rotate(180deg);
  }

  /*
   * Desktop submenu: Tailwind v4 không sinh đúng variant group-hover/nav-sub với breakpoint;
   * dùng :hover / :focus-within trên li.nav-submenu-parent.
   */
  @media (min-width: 1024px) {
    .nav-submenu-parent > .nav-submenu-panel {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translateY(0.35rem);
      transition:
        opacity 0.18s ease,
        visibility 0.18s ease,
        transform 0.18s ease;
    }

    .nav-submenu-parent:hover > .nav-submenu-panel,
    .nav-submenu-parent:focus-within > .nav-submenu-panel {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateY(0);
    }

    .nav-submenu-chevron-desktop {
      transition: transform 0.18s ease;
    }

    .nav-submenu-parent:hover .nav-submenu-chevron-desktop {
      transform: rotate(180deg);
    }
  }
</style>
