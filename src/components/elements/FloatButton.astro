---
const messengerUrl = "https://m.me/61567149392994";
const zaloUrl = "https://zalo.me/0399812700";
---

<div class="fixed bottom-0 right-0">
    <a
  href={zaloUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Liên hệ qua Zalo"
  class="fixed messenger-float bottom-20 md:bottom-25 left-5 md:left-auto md:right-5 z-50 inline-flex w-12 h-12 items-center justify-center rounded-full bg-primary px-5 text-white shadow-lg transition hover:scale-105 hover:shadow-xl focus:outline-none focus:ring-2 focus:ring-[#0068ff] focus:ring-offset-2"
>
  <span class="text-sm font-semibold tracking-wide">Zalo</span>
</a>

<a
      href={messengerUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="
        fixed
        bottom-20
        lg:bottom-5
        right-5
        z-50
        flex
        relative
        items-center
        justify-center
        w-12
        h-12
        rounded-full
        shadow-lg
        transition
        hover:scale-110
        messenger-float
      "
      style={{
        backgroundColor: "var(--color-primary)",
      }}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="28"
        height="28"
        fill="white"
        viewBox="0 0 24 24"
        class="relative z-10"
      >
        <path d="M12 2C6.477 2 2 6.145 2 11.25c0 2.91 1.472 5.505 3.77 7.2V22l3.29-1.806c.93.258 1.91.396 2.94.396 5.523 0 10-4.145 10-9.25S17.523 2 12 2zm1.057 12.422-2.548-2.717-4.965 2.717 5.463-5.8 2.485 2.717 5.028-2.717-5.463 5.8z" />
      </svg>
    </a>
</div>

<style>
  .messenger-float::before,
  .messenger-float::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: 9999px;
    background-color: rgba(10, 199, 26, 0.35);
    animation: messenger-ripple 1.8s ease-out infinite;
  }

  .messenger-float::after {
    animation-delay: 0.9s;
  }

  @keyframes messenger-ripple {
    0% {
      opacity: 0.7;
      transform: scale(1);
    }

    100% {
      opacity: 0;
      transform: scale(1.8);
    }
  }
</style>