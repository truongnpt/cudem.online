---
import GroupFooterNav from "../blocks/GroupFooterNav.astro";
import Container from "../shared/Container.astro";
import FooterNav from "../shared/FooterNav.astro";
import Paragraph from "../shared/Paragraph.astro";
import { app } from "../../configs/app";
import { services } from "../../utils/data";
import FloatButton from "./FloatButton.astro";
const footerNav1 = services.map((s) => ({
  itemText: s.title,
  itemLink: `/services/${s.slug}`,
}));

const footerSupport = [
  {
    itemText: "Báo giá nhanh",
    itemLink: "/packages",
  },
  {
    itemText: "Quy trình triển khai",
    itemLink: "/process-deployment",
  },
  {
    itemText: "Câu hỏi thường gặp",
    itemLink: "/faqs",
  },
  {
    itemText: "Liên hệ tư vấn",
    itemLink: "/contact",
  },
];

const footerCompany = [
  {
    itemText: "Về chúng tôi",
    itemLink: "/about-us",
  },
  {
    itemText: "Dự án",
    itemLink: "/projects",
  },
  {
    itemText: "Đối tác & khách hàng",
    itemLink: "/#partners",
  },
];

const footerContact = [
  {
    itemText: "Email: truongnpt1998@...",
    itemLink: "mailto:truongnpt1998@gmail.com",
  },
  {
    itemText: "Số điện thoại: 0399812700",
    itemLink: "tel:0399812700",
  }
];
---

<div class="mt-16"></div>
<footer
  class="relative bg-gradient-to-tr from-gray-100 to-gray-200 dark:from-gray-900 dark:to-transparent pt-16 lg:pt-28 rounded-t-3xl"
>
  <div class="absolute right-0 top-0 h-full w-full flex justify-end">
    <div class="w-28 h-28 overflow-auto flex rounded-xl relative blur-2xl">
      <span
        class="absolute w-16 h-16 -top-1 -right-1 bg-green-500 rounded-md rotate-45"
      ></span>
      <span
        class="absolute w-16 h-16 -bottom-1 -right-1 bg-[#FCDC58] rounded-md rotate-45"
      ></span>
      <span
        class="absolute w-16 h-16 -bottom-1 -left-1 bg-primary rounded-md rotate-45"
      ></span>
    </div>
  </div>

  <div class="absolute left-0 bottom-0 h-full w-full flex items-end">
    <div class="w-28 h-28 overflow-auto flex rounded-xl relative blur-2xl">
      <span
        class="absolute w-16 h-16 -top-1 -right-1 bg-green-500 rounded-md rotate-45"
      ></span>
      <span
        class="absolute w-16 h-16 -bottom-1 -right-1 bg-[#FCDC58] rounded-md rotate-45"
      ></span>
      <span
        class="absolute w-16 h-16 -bottom-1 -left-1 bg-primary rounded-md rotate-45"
      ></span>
    </div>
  </div>
  <Container className="pb-8 relative overflow-auto">
    <span
      class="absolute top-1/2 left-1/2 -translate-y-1/2 -translate-x-1/2 blur-2xl opacity-20 w-24 h-16 sm:w-48 sm:h-36 rounded-full rotate-12 skew-x-6 bg-primary"
    ></span>
    <div
      class="grid grid-cols-2 lg:grid-cols-3 lg:items-stretch gap-8 relative"
    >
      <div class="col-span-2 lg:col-span-1 h-auto flex flex-col">
        <div class="h-full">
          <a href="/" class="relative flex items-center gap-0">
            <img src={app.logo} alt={app.name} class="w-20 h-auto" />
            <div class="flex flex-col gap-4 items-start justify-end text-lg font-semibold text-heading-1 !h-[103px]">
              <h3 class="text-primary text-3xl leading-none">{app.service}</h3>
              <h3 class="text-black text-2xl leading-none">{app.online}</h3>
            </div>
          </a>
          <Paragraph className={"mt-8"}>
            {app.footer.description}
          </Paragraph>
        </div>

        <!-- social links -->
        <!-- <div class="min-h-max flex items-center gap-4 text-heading-3 mt-8">
          {
            Object.values(app.footer.socials).map((social) => (
              <a
                href={social.url}
                target="_blank"
                class="transition hover:text-heading-1 hover:scale-105 flex items-center gap-2"
              >
                <slot set:html={social.icon} />
                <span class="text-heading-3">{social.name}</span>
              </a>
            ))
          }
        </div> -->
      </div>

      <GroupFooterNav>
        <FooterNav title={"Tổng quan"} navItems={footerCompany} />
        <FooterNav title={"Dịch vụ"} navItems={footerNav1} />
      </GroupFooterNav>

      <GroupFooterNav>
        <FooterNav title={"Hỗ trợ"} navItems={footerSupport} />
        <FooterNav title={"Liên hệ"} navItems={footerContact} />
      </GroupFooterNav>
    </div>
  </Container>
  <div class="py-2 relative">
    <Container>
      <div
        class="flex justify-between items-center gap-6 md:text-lg text-heading-3"
      >
        <div class="text-sm md:text-base">
          &copy; <span id="year">{new Date().getFullYear()}</span>
          {app.name}. {app.footer.copyright}
        </div>
        <div class="text-right max-md:text-left text-sm md:text-base">
          Được phát triển bởi{" "}
          <span class="font-semibold text-heading-2">{app.footer.author}</span>
        </div>
      </div>
    </Container>
  </div>
</footer>

<FloatButton />