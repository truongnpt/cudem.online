---
import BtnLink from "../shared/BtnLink.astro";

export interface Props {
  title: string;
  discountPercent: number;
  features: string[];
  priceVnd?: number;
  ctaHref: string;
  ctaText: string;
  ctaVariant: "primary" | "secondary";
}

const {
  title,
  discountPercent,
  features,
  priceVnd,
  ctaHref,
  ctaText,
  ctaVariant,
} = Astro.props;

const formatVnd = (amount: number) => `${amount.toLocaleString("vi-VN")} VNĐ`;

const hasFixedPrice = typeof priceVnd === "number";
const showDiscountBadge = discountPercent > 0;
const discountedAmount =
  hasFixedPrice && showDiscountBadge
    ? Math.round(priceVnd * (1 - discountPercent / 100))
    : hasFixedPrice
      ? priceVnd
      : null;
---

<div
  class="p-5 sm:p-6 lg:p-8 rounded-3xl border border-box-border bg-box-bg shadow-lg shadow-box-shadow relative overflow-hidden flex flex-col h-full"
>
  {
    showDiscountBadge && (
      <span class="absolute top-4 right-4 text-xs font-semibold uppercase tracking-wide text-primary bg-primary/10 px-3 py-1 rounded-full">
        Giảm {discountPercent}%
      </span>
    )
  }

  <div class:list={["relative", showDiscountBadge && "mt-4"]}>
    <h2 class="text-lg md:text-xl font-semibold text-heading-2">
      {title}
    </h2>
    <div class="mt-4 space-y-1">
      {
        !hasFixedPrice && (
          <p class="text-2xl sm:text-3xl font-semibold text-heading-1">
            Liên hệ
          </p>
        )
      }
      {
        hasFixedPrice &&
          showDiscountBadge &&
          typeof discountedAmount === "number" && (
            <>
              <p class="text-sm text-heading-3 line-through">
                {formatVnd(priceVnd!)}
              </p>
              <p class="text-2xl sm:text-3xl font-semibold text-heading-1 text-primary">
                {formatVnd(discountedAmount)}
              </p>
            </>
          )
      }
      {
        hasFixedPrice && !showDiscountBadge && (
          <p class="text-2xl sm:text-3xl font-semibold text-heading-1">
            {formatVnd(priceVnd!)}
          </p>
        )
      }
    </div>
  </div>

  <ul class="mt-6 space-y-3 flex-1 relative">
    {
      features.map((feature) => (
        <li class="flex gap-3 text-heading-3 md:text-lg">
          <span
            class="mt-1 shrink-0 w-5 h-5 rounded-full bg-primary/15 text-primary flex items-center justify-center"
            aria-hidden="true"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 20 20"
              fill="currentColor"
              class="w-3 h-3"
            >
              <path
                fill-rule="evenodd"
                d="M16.704 5.29a1 1 0 010 1.42l-7.995 8a1 1 0 01-1.414 0l-3.999-4a1 1 0 011.414-1.414l3.293 3.293 7.293-7.293a1 1 0 011.414 0z"
                clip-rule="evenodd"
              />
            </svg>
          </span>
          <span>{feature}</span>
        </li>
      ))
    }
  </ul>

  <div class="mt-8 pt-2 relative z-10">
    <BtnLink
      href={ctaHref}
      text={ctaText}
      variant={ctaVariant}
      className="inline-flex !w-full justify-center text-center sm:w-auto"
    />
  </div>

  <span
    class="pointer-events-none absolute w-32 aspect-square -bottom-16 -right-16 bg-primary/10 rounded-full"
  ></span>
</div>
