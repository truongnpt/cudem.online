---
import Container from "../shared/Container.astro";
import Title from "../shared/Title.astro";
import Paragraph from "../shared/Paragraph.astro";
import {
  websiteProjects,
  webApplicationProjects,
  mobileAppProjects,
} from "../../utils/data";

const projectGroups = [
  {
    title: "Website đã triển khai",
    items: websiteProjects,
    layout: "single" as const,
  },
  {
    title: "Web application đã triển khai",
    items: webApplicationProjects,
    layout: "single" as const,
  },
  {
    title: "Mobile App đã triển khai",
    items: mobileAppProjects,
    layout: "dual" as const,
  },
];
---

<section id="partners">
  <Container className="space-y-8">
    <div class="text-center max-w-3xl mx-auto">
      <Title>Các dự án đã triển khai</Title>
      <Paragraph className="mt-3">
        Một số dự án tiêu biểu từ mảng website, web application và mobile app đã
        triển khai.
      </Paragraph>
    </div>
    <div class="space-y-10">
      {
        projectGroups.map((group) => (
          <div class="space-y-4">
            <h3 class="text-xl font-semibold text-heading-2">{group.title}</h3>
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {group.items.map((project) => (
                <article class="rounded-2xl bg-body border border-box-border p-4 sm:p-5">
                  {group.layout === "dual" && "images" in project && Array.isArray(project.images) ? (
                    <div class="grid grid-cols-2 gap-2">
                      {project.images.slice(0, 2).map((src: string, i: number) => (
                        <div class="flex min-h-[12rem] items-center justify-center rounded-xl bg-white p-2 dark:bg-white/[0.04]">
                          <img
                            src={src}
                            alt={`${project.imageAlt} (${i + 1})`}
                            class="max-h-52 w-auto rounded-lg object-contain"
                            loading="lazy"
                          />
                        </div>
                      ))}
                    </div>
                  ) : (
                    <div class="flex min-h-[11rem] items-center justify-center rounded-xl bg-white dark:bg-white/[0.04]">
                      <img
                        src={project.image}
                        alt={project.imageAlt}
                        class="aspect-[16/9] w-full rounded-xl object-cover"
                        loading="lazy"
                      />
                    </div>
                  )}
                  <div class="mt-3 space-y-2">
                    <p class="font-semibold text-heading-2">{project.name}</p>
                    <span class="inline-flex items-center rounded-full bg-primary/12 px-3 py-1 text-xs font-semibold uppercase tracking-[0.12em] text-primary ring-1 ring-primary/20">
                      {project.industry}
                    </span>
                    <p class="text-sm text-heading-3">{project.summary}</p>
                  </div>
                </article>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </Container>
</section>
