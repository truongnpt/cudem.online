---
import Container from "../shared/Container.astro";
import Title from "../shared/Title.astro";
import Paragraph from "../shared/Paragraph.astro";
import { websiteProjects, webApplicationProjects } from "../../utils/data";

const projectGroups = [
  {
    title: "Website đã triển khai",
    items: websiteProjects,
  },
  {
    title: "Web application đã triển khai",
    items: webApplicationProjects,
  },
];
---

<section id="partners">
  <Container className="space-y-8">
    <div class="text-center max-w-3xl mx-auto">
      <Title>Các dự án đã triển khai</Title>
      <Paragraph className="mt-3">
        Một số dự án tiêu biểu từ mảng website và web application đã triển khai.
      </Paragraph>
    </div>
    <div class="space-y-10">
      {
        projectGroups.map((group) => (
          <div class="space-y-4">
            <h3 class="text-xl font-semibold text-heading-2">{group.title}</h3>
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {group.items.map((project) => (
                <article class="rounded-2xl bg-body border border-box-border p-4 sm:p-5">
                  <img
                    src={project.image}
                    alt={project.imageAlt}
                    class="aspect-[16/9] w-full rounded-xl object-cover"
                    loading="lazy"
                  />
                  <div class="mt-3">
                    <p class="font-semibold text-heading-2">{project.name}</p>
                    <p class="text-sm text-heading-3">{project.industry}</p>
                  </div>
                </article>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </Container>
</section>
