---
import Service from "../cards/Service.astro";
import Container from "../shared/Container.astro";
import Paragraph from "../shared/Paragraph.astro";
import Title from "../shared/Title.astro";
import { services } from "../../utils/data.ts";


type ServicesProps = {
    title: string;
    description: string;
    icon: string;
    slug: string;
};


---

<section id="services">
    <Container className="space-y-10 md:sapce-y-12">
        <div class="text-center max-w-3xl mx-auto space-y-4">
            <Title>
                Dịch vụ chúng tôi cung cấp
            </Title>
            <Paragraph>
                Giải pháp số toàn diện — website, landing, ecommerce và mobile app — từ giao diện đến hiệu suất để giúp doanh nghiệp tăng chuyển đổi và vận hành tốt hơn.
            </Paragraph>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-2 xl:grid-cols-4 gap-6 lg:gap-8">
            {
                    services.map((service: ServicesProps) => {
                    return (
                            <a
                              href={`/services/${service.slug}`}
                              class="block h-full rounded-3xl transition hover:-translate-y-0.5 hover:shadow-xl focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary/35"
                            >
                            <Service title={service.title} description={service.description} icon={service.icon}>
                            </Service>
                            </a>
                            );
                    })
            }
        </div>
    </Container>
</section>
