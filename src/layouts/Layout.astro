---
import Footer from "../components/elements/Footer.astro";
import Navbar from "../components/elements/Navbar.astro";
import { app } from "../configs/app";
export interface Props {
  title: string;
  /** robots noindex (vd. trang 404) */
  noindex?: boolean;
}

const { title, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={app.description} />
    <meta property="og:image" content={import.meta.env.VERCEL_URL_APP + app.logo} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <title>{app.name} - {title}</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Raleway:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="preload" imagesrcset={import.meta.env.VERCEL_URL_APP + app.logo} as="image" />
  </head>
  <body class="overflow-hidden overflow-y-auto bg-body">
    <Navbar />
    <slot />
    <Footer />
  </body>
  <script>
    const switchTheme = document.querySelector(
      "[data-switch-theme]",
    ) as HTMLButtonElement;

    if (
      localStorage.getItem("appTheme") === "dark" ||
      (!("appTheme" in localStorage) &&
        window.matchMedia("(prefers-color-scheme: dark)").matches)
    ) {
      document.documentElement.classList.add("dark");
    } else {
      document.documentElement.classList.remove("dark");
    }
    if (switchTheme) {
      switchTheme.addEventListener("click", (e) => {
        e.preventDefault();
        const doc = document.documentElement;
        if (doc) {
          if (localStorage.getItem("appTheme")) {
            if (localStorage.getItem("appTheme") === "light") {
              doc.classList.add("dark");
              localStorage.setItem("appTheme", "dark");
            } else {
              document.documentElement.classList.remove("dark");
              localStorage.setItem("appTheme", "light");
            }
          } else {
            if (doc.classList.contains("dark")) {
              doc.classList.remove("dark");
              localStorage.setItem("appTheme", "light");
            } else {
              doc.classList.add("dark");
              localStorage.setItem("appTheme", "dark");
            }
          }
        }
      });
    }
  </script>
  <script>
    const toggleMenu = document.querySelector(
      "[data-toggle-nav]",
    ) as HTMLButtonElement;
    const navbar = document.querySelector("[data-navbar]") as HTMLDivElement;
    const overlayNav = document.querySelector(
      "[data-nav-overlay]",
    ) as HTMLDivElement;
    function closeMobileMenu() {
      toggleMenu.setAttribute("data-open-nav", "false");
      toggleMenu.setAttribute("aria-expanded", "false");
      overlayNav.setAttribute("data-is-visible", "false");
      navbar.setAttribute("data-drawer-open", "false");
      document.body.classList.remove("!overflow-y-hidden");
      navbar.querySelectorAll("[data-nav-submenu-toggle]").forEach((btn) => {
        btn.setAttribute("aria-expanded", "false");
      });
      navbar.querySelectorAll("[data-nav-submenu-panel]").forEach((panel) => {
        panel.removeAttribute("data-open");
        panel.setAttribute("aria-hidden", "true");
      });
    }
    function openMobileMenu() {
      toggleMenu.setAttribute("data-open-nav", "true");
      toggleMenu.setAttribute("aria-expanded", "true");
      overlayNav.setAttribute("data-is-visible", "true");
      navbar.setAttribute("data-drawer-open", "true");
      document.body.classList.add("!overflow-y-hidden");
    }
    if (toggleMenu && navbar && overlayNav) {
      toggleMenu.addEventListener("click", (e) => {
        e.preventDefault();
        if (toggleMenu.getAttribute("data-open-nav") === "false") {
          openMobileMenu();
        } else {
          closeMobileMenu();
        }
      });

      navbar.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        if (target.closest("[data-close-drawer]")) {
          e.preventDefault();
          closeMobileMenu();
          return;
        }
        if (target.closest("a[href]")) {
          closeMobileMenu();
        }
      });

      overlayNav.addEventListener("click", () => {
        closeMobileMenu();
      });

      document.addEventListener("keydown", (e) => {
        if (
          e.key === "Escape" &&
          navbar.getAttribute("data-drawer-open") === "true"
        ) {
          closeMobileMenu();
        }
      });

      window.addEventListener(
        "resize",
        () => {
          if (
            window.matchMedia("(min-width: 1024px)").matches &&
            navbar.getAttribute("data-drawer-open") === "true"
          ) {
            closeMobileMenu();
          }
        },
        { passive: true },
      );
    }
  </script>
</html>
<style is:global>
  :root {
    --color-bg: 255 255 255;
    --color-border: 255 255 255;
    --color-box: 255 255 255;
    --box-border: 229 231 235;
    --box-sd: 226 232 240 / 0.5;
    --heading-1: 23 37 84;
    --heading-2: 31 41 55;
    --heading-3: 55 65 81;
  }

  .dark {
    --color-bg: 3 7 18;
    --color-box: 17 24 39;
    --box-border: 243 244 246/0.1;
    --box-sd: transparent;

    --heading-1: 255 255 255;
    --heading-2: 243 244 246;
    --heading-3: 209 213 219;
  }

  html {
    scroll-behavior: smooth;
  }
  body {
    font-family: "Raleway", sans-serif;
  }

  [data-toggle-nav][data-open-nav="true"] #line1 {
    transform: translateY(0.375rem) rotate(40deg);
  }
  [data-toggle-nav][data-open-nav="true"] #line2 {
    transform: scaleX(0);
    opacity: 0;
  }
  [data-toggle-nav][data-open-nav="true"] #line3 {
    transform: translateY(-0.375rem) rotate(-40deg);
  }

  [data-nav-overlay][data-is-visible="true"] {
    visibility: visible;
    display: flex;
  }
</style>
